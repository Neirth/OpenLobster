{
  "name": "OpenLobster",
  "description": "Personal AI Assistant with Neo4j Memory and Vault Secrets",
  "parameters": [
    {
      "name": "OPENLOBSTER_GRAPHQL_AUTH_TOKEN",
      "label": "GraphQL Auth Token",
      "description": "Secret token for dashboard authentication",
      "type": "string",
      "required": true
    },
    {
      "name": "NEO4J_PASSWORD",
      "label": "Neo4j Password",
      "description": "Password for the database",
      "type": "string",
      "required": true
    },
    {
      "name": "VAULT_ROOT_TOKEN",
      "label": "Vault Root Token",
      "description": "Root token for Vault dev mode",
      "type": "string",
      "required": true
    }
  ],
  "hooks": {
    "pre-deploy": {
      "commands": [
        "echo Deployment starting..."
      ]
    }
  }
}
