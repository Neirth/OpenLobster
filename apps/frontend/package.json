    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.1.0",
    "markdown-it": "^14.3.0",
    "parse-prometheus-text-format": "^1.1.1",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
