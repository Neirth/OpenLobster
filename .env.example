# OpenLobster Environment Configuration
# Copy this file to .env and fill in your secrets.

# --- Security ---
# Bearer token for the GraphQL API and Dashboard.
# Set this to a long random string.
OPENLOBSTER_GRAPHQL_AUTH_TOKEN=your-random-secret-token

# --- Memory (Neo4j) ---
# Password for the Neo4j database. 
NEO4J_PASSWORD=password123

# --- Secrets (Vault/OpenBao) ---
# Initial root token for Vault (Dev Mode).
VAULT_ROOT_TOKEN=myroot

# --- AI Providers (Optional) ---
# Your OpenAI API Key for agent capabilities.
# OPENAI_API_KEY=sk-...

# --- Network ---
# Host to bind the GraphQL server to.
# OPENLOBSTER_GRAPHQL_HOST=0.0.0.0
